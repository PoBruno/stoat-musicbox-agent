# Endereço da sua instância do Stoat.
# Sem isto o agente ainda sobe e resolve — só não se registra no servidor.
STOAT_URL=https://discord.monga.dev.br

# Segredo compartilhado com o Stoat. É o que prova que este agente é seu.
# Gere um valor longo e aleatório, por exemplo:
#   openssl rand -hex 32
AGENTE_SEGREDO=

# Porta da API local de diagnóstico. Fica presa em 127.0.0.1 pelo compose.
PORTA=7700

# Intervalo do batimento para o servidor, em milissegundos.
BATIMENTO_MS=15000

# Atualizar o yt-dlp a cada partida.
# Recomendado deixar ligado: o YouTube muda de propósito, e uma versão velha
# é a causa mais comum de "parou de funcionar do nada".
ATUALIZAR_YTDLP=1
