# Endereco da API do STOAT.
#
# Em producao e a instancia publica, com o sufixo /api:
#   STOAT_URL=https://discord.monga.dev.br/api
# Em desenvolvimento, o delta nativo:
#   STOAT_URL=http://127.0.0.1:14702
STOAT_URL=

# Segredo compartilhado com a instancia. Precisa ser IDENTICO ao
# REVOLT__MUSICBOX__AGENT_SECRET configurado no servidor.
#
# Gere com: openssl rand -hex 32
AGENTE_SEGREDO=

# Porta da API local de diagnostico. So escuta em 127.0.0.1.
PORTA=7700

# Intervalo do batimento, em milissegundos.
BATIMENTO_MS=15000

# Atualizar o yt-dlp na partida. O YouTube muda de proposito, e versao velha
# e a causa mais comum de "parou de funcionar do nada". 0 desliga.
ATUALIZAR_YTDLP=1
